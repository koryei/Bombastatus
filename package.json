{
  "name": "bombastatus",
  "version": "0.1.0",
  "description": "Keep a Discord account online 24/7 with a scheduled, auto-cycling custom status.",
  "author": "Koryei",
  "homepage": "https://github.com/koryei/Bombastatus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koryei/Bombastatus.git"
  },
  "bugs": {
    "url": "https://github.com/koryei/Bombastatus/issues"
  },
  "keywords": [
    "discord",
    "status",
    "custom-status",
    "scheduler",
    "tray",
    "menu-bar",
    "presence"
  ],
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "tray": "electron src/tray/main.js",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bombastatus.app",
    "productName": "Bombastatus",
    "extraMetadata": {
      "main": "src/tray/main.js"
    },
    "files": [
      "src/**",
      "config.example.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
